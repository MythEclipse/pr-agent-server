# Secrets — never commit
*.pem
*credentials*.json
webhook_secret.txt
whsec*.txt
.secrets.toml
.env
.env.*
**/node_modules/**
# Python
__pycache__/
*.pyc
result

# Monorepo — moon's config (.moon/workspace.yml, toolchain.yml, tasks.yml) is
