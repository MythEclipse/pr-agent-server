.moon/cache/
.moon/docker/
node_modules/
.pnpm-store/

# Drizzle / Postgres local data
.postgres-data/
# Packaging
*.egg-info/
.eggs/
dist/
build/
.venv/

# Runtime data
*.log
*.pid

# Planning files (session scratch)
.planning/
.tmp/

# Bun TS build artifacts
*.tsbuildinfo

