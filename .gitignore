# Secrets — never commit
*.pem
*credentials*.json
webhook_secret.txt
whsec*.txt
.secrets.toml
.env
.env.*
**/node_modules/**
# Python
__pycache__/
*.pyc
result

# Monorepo — moon's config (.moon/workspace.yml, toolchain.yml, tasks.yml) is
# source-controlled; only its build cache and local toolchain download are not.
.moon/cache/
.moon/docker/
node_modules/
.pnpm-store/

# Drizzle / Postgres local data
.postgres-data/
# Packaging
*.egg-info/
.eggs/
dist/
build/
.venv/

# Runtime data
*.log
*.pid

# Planning files (session scratch)
.planning/
.tmp/

# Bun TS build artifacts
*.tsbuildinfo

# Vite / TanStack Router generated
#
# apps/web/src/routeTree.gen.ts is generated by the TanStack Router vite plugin
# (see apps/web/vite.config.ts), but it is NOT ignored: `tsc --noEmit` needs the
# route tree's types, and the plugin only runs during build/dev — which happens
# after typecheck in CI. A fresh clone would otherwise fail typecheck with
# TS2307 on ./routeTree.gen.ts.
#
# Codegen is deterministic (byte-identical across runs), so tracking it is safe.
# ci.yml runs a drift check after build to catch a stale committed tree.
