# PR-Agent webhook server — the GitHub App that reviews PRs.
#
# This unit was never committed before the Node migration (the old one lives
# only on the box), which meant rebuilding the deploy from the repo alone could
# not reproduce the server half. It is committed now for that reason.
#
# DEPLOY TARGET: /opt/pr-agent-server. The pr-agent user cannot read /home/code
# (mode 750), so running from a checkout is impossible; deploy.yml ships the
# compiled dist/ plus a self-contained node_modules.
#
# SECRETS: bws-exec `pr-agent` supplies DATABASE_URL, BETTER_AUTH_SECRET, the
# webhook secret and the LLM key. Nothing sensitive lives in this file.
#
# PORT 4023 is load-bearing: the health watchdog cron and deploy.yml's poll
# both curl http://127.0.0.1:4023/health.
[Unit]
Description=PR-Agent webhook server (Node/TypeScript)
After=network-online.target
Requires=network-online.target

[Service]
Type=simple
User=pr-agent
Group=pr-agent
WorkingDirectory=/opt/pr-agent-server
Environment=NODE_ENV=production
Environment=PORT=4023
# Restart-safe queue. The schema default in env.ts is "memory", which keeps the
# queue in a Set inside the process: a restart (deploy, crash, OOM) silently
# drops every in-flight review with no record that it was ever queued. The "db"
# driver stores jobs in review_queue_jobs, claims them with SKIP LOCKED, and
# requeues anything left `running` on boot, so a restart costs a slow review
# rather than a lost one.
#
# This is production-only on purpose. The in-memory queue is what the unit
# tests and the local dev loop assert against (env.ts keeps defaulting to
# "memory"); flipping the code default would silently rewrite that contract.
# review_queue_jobs is created by the committed drizzle migrations, which CI
# checks for drift, so the table is present wherever this unit has been migrated.
Environment=QUEUE_BACKEND=db
# WEB_DIST_PATH is how the built SPA reaches the browser: Hono serves it and
# falls through to index.html, so there is no second process to supervise.
Environment=WEB_DIST_PATH=/opt/pr-agent-server/web-dist
Environment=HOME=/var/lib/pr-agent-server
Environment=PR_AGENT_APP_DIR=/var/lib/pr-agent-server
Environment=PR_AGENT_KEY_PATH=/var/lib/pr-agent-server/private-key.pem
Environment=PR_AGENT_ANALYTICS_DIR=/var/lib/pr-agent-server/analytics
# The PUBLIC origin, and it is not cosmetic. `env.ts` defaults both of these to
# localhost (http://localhost:4023 / http://localhost:5173), and better-auth
# validates every sign-in against `BETTER_AUTH_URL` + `trustedOrigins`. With these
# unset, a login POSTed from https://pr-agent.asepharyana.my.id was rejected with
# 403 INVALID_ORIGIN — i.e. the dashboard served fine and could never be signed
# into. Measured on the box before this line existed: both were <unset>, and the
# sign-in attempt above failed on origin, not on the password.
#
# BETTER_AUTH_URL is also what better-auth uses to build callback/cookie URLs, so
# pointing it at the real host keeps the session cookie first-party.
Environment=BETTER_AUTH_URL=https://pr-agent.asepharyana.my.id
Environment=WEB_ORIGIN=https://pr-agent.asepharyana.my.id
# Google sign-in. WHO may sign in is decided by AUTH_ALLOWED_EMAILS, NOT by Google:
# Google authenticates any account, so without the list this button would expose the
# review history to anyone. Comma-separated, case-insensitive, no wildcards.
#
# The list is also re-checked on every request (see resolveSession), so removing an
# address takes effect immediately instead of at session expiry. An EMPTY value
# denies everybody by design — it does not mean "allow all".
Environment=AUTH_ALLOWED_EMAILS=superaseph@gmail.com,asepharyana@gmail.com
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are NOT set here: `bws-exec pr-agent`
# already exports every `pr_agent_*` vault entry with the prefix stripped and
# uppercased, so `pr_agent_google_client_id` arrives as GOOGLE_CLIENT_ID inside the
# ExecStart below. Listing them again here would be redundant, and a `%name`
# indirection is not systemd syntax at all.
# Analytics are append-only JSONL under /var/lib/pr-agent-server, and the
# worker's /tmp/pr-queue-* state must survive a restart — so this unit needs a
# real filesystem, not a private /tmp namespace.
PrivateTmp=false
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/pr-agent-server /opt/pr-agent-server
ExecStart=/usr/local/bin/bws-exec pr-agent env PORT=4023 /opt/node/bin/node /opt/pr-agent-server/dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target